# 复制为 .env 后填写。不要把 .env 提交到仓库。

# ---------- 基础 ----------
COMPOSE_PROJECT_NAME=ragdock
TZ=Asia/Shanghai
RAGFLOW_VERSION=v1.0.0
GATEWAY_PORT=4000
WECOM_PORT=8088

# ---------- 模型（建议用 scripts/modelctl.py 改写，不要手填）----------
# 聊天模型
LLM_PROFILE=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 向量模型（RAGFlow 建知识库时必填，换它会要求重建索引）
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v4

# 重排模型（可选，留空则不启用）
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# 网关鉴权：RAGFlow 里新增模型供应商时填这个
LITELLM_MASTER_KEY=sk-ragdock-local

# ---------- RAGFlow 对接 ----------
# 容器内访问宿主机上的 RAGFlow（compose 已配 host-gateway）
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=
RAGFLOW_CHAT_ID=
RAGFLOW_TIMEOUT=90
# 带多少轮历史（0 = 无记忆，每句独立）
RAGFLOW_HISTORY_TURNS=3

# ---------- 企业微信 ----------
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
# 按部门路由到不同知识库助手：{"2":"chat_id_a","3":"chat_id_b"}
WECOM_ROUTES={}
# 单条回复最大字数，超出截断（企微文本上限 2048 字节）
WECOM_MAX_CHARS=1500
